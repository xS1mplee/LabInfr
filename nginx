events {
    worker_connections 1024;
}

http {
    # Balanceo de carga para Produccion
    upstream backend_prod {
        server api-prod-1:8080;
        server api-prod-2:8080;
    }

    # Instancia de QA
    upstream backend_qa {
        server api-qa:8080;
    }

    # Enrutamiento de Produccion por Nombre de Dominio
    server {
        listen 80;
        server_name api.dominio.com;

        location / {
            proxy_pass http://backend_prod;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }

    # Enrutamiento de QA por Nombre de Dominio
    server {
        listen 80;
        server_name qa-api.dominio.com;

        location / {
            proxy_pass http://backend_qa;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}